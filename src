# 获取系统中的所有盘符
def get_drives():
    drives = []
    for drive in range(ord('C'), ord('Z') + 1):
        drive_path = f"{chr(drive)}:\\"
        if os.path.exists(drive_path):
            drives.append(drive_path)
    return drives

# 检查文件是否有读取权限
def has_read_permission(file_path):
    try:
        if not os.path.exists(file_path):
            print(f"文件 {file_path} 不存在")
            return False
        if os.access(file_path, os.R_OK):
            return True
        else:
            print(f"没有读取文件 {file_path} 的权限")
            return False
    except Exception as e:
        print(f"检查文件 {file_path} 权限时发生错误: {e}")
        return False

# 封装的读取函数，先检查权限
def try_read_file(file_path, read_function):
    if has_read_permission(file_path):
        try:
            return read_function(file_path)
        except UnicodeDecodeError as e:
            print(f"读取文件 {file_path} 时发生编码错误: {e}")
        except IOError as e:
            print(f"读取文件 {file_path} 时发生IO错误: {e}")
        except Exception as e:
            print(f"读取文件 {file_path} 时发生未知错误: {e}")
    else:
        print(f"没有读取 {file_path} 的权限或文件不存在")
    return None

# 关键字扫描功能：返回命中的关键词列表和每个关键词的命中次数
def contains(longstr, keywords):
    hit_keywords = {}
    total_hits = 0
    for key in keywords:
        count = longstr.count(key)  # 统计每个关键词的命中次数
        if count > 0:
            hit_keywords[key] = count
            total_hits += count
    return hit_keywords, total_hits


# 身份证号提取功能
def idset(text):
    idset = set()
    temp = ''
    for c in text:
        if c.isdigit() or c == 'x' or c == 'X':
            temp += c
        else:
            # 检查是否是一个完整的身份证号
            if len(temp) == 18:
                idset.add(temp)
            temp = ''

    # 检查最后的身份证号
    if len(temp) == 18:
        idset.add(temp)

    return idset

