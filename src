def perform_scan(scan_type, folder_path, result_filename, file_count, progress_var, progress_window):
    try:
        # 获取自定义关键词
        custom_keywords = re.split(r'[；;]', keyword_entry.get())
        custom_keywords = [word.strip() for word in custom_keywords if word.strip()]
        keywords_to_use = custom_keywords if custom_keywords else default_keywords

        scanned_files = 0
        all_results = []  # 用于存储所有文件的扫描结果

        # 初始化统计数据
        stats = {
            "total_keyword_hits": 0,
            "keyword_hits": {key: 0 for key in keywords_to_use},
            "total_id_count": 0,
            "matched_ids": [],  # 使用列表记录身份证号
            "total_phone_count": 0,
            "matched_phones": [],  # 使用列表记录手机号
        }

        # 创建 result 文件夹（如果不存在）
        current_dir = os.path.dirname(os.path.abspath(sys.executable))  # 获取 .exe 文件所在的目录
        result_folder = os.path.join(current_dir, "result")  # 将 result 文件夹放在当前目录下
        if not os.path.exists(result_folder):
            os.makedirs(result_folder)  # 如果 result 文件夹不存在，则创建
        # 定义 scan_type 的映射字典
        scan_type_map = {
            "id":"id",
            "keyword": "sw",
            "phone": "mp"
        }

        # 将 scan_type 替换为对应的新值
        mapped_scan_type = scan_type_map.get(scan_type, scan_type)  # 如果找不到对应值，保持原值

        # 拼接结果文件路径
        result_filename = os.path.join(
            result_folder,
            f'result_{mapped_scan_type}_{datetime.now().strftime("%Y%m%d_%H%M%S")}.txt'
        )

        # # 将结果文件保存在 result 文件夹中
        # result_filename = os.path.join(result_folder,
        #                                f'result_{scan_type}_{datetime.now().strftime("%Y%m%d_%H%M%S")}.txt')
        # # 遍历文件夹并扫描文件
        for root_dir, _, files in os.walk(folder_path):
            for file_name in files:
                if not file_name.startswith('~$'):  # 跳过临时文件
                    file_path = os.path.normpath(os.path.join(root_dir, file_name))  # 格式化为反斜杠路径
                    try:
                        # 调用 traversal_folder 扫描文件并获取结果
                        results, file_stats = traversal_folder(file_path, keywords_to_use, scan_type)
                        all_results.extend(results)  # 收集文件扫描的结果

                        # 累加统计数据
                        stats["total_keyword_hits"] += file_stats.get("total_keyword_hits", 0)
                        for key, count in file_stats.get("keyword_hits", {}).items():
                            stats["keyword_hits"][key] += count
                        stats["total_id_count"] += file_stats.get("total_id_count", 0)

                        # 使用 extend 并去重
                        stats["matched_ids"].extend(file_stats.get("matched_ids", []))
                        #stats["matched_ids"] = list(set(stats["matched_ids"]))  # 去重

                        stats["total_phone_count"] += file_stats.get("total_phone_count", 0)
                        stats["matched_phones"].extend(file_stats.get("matched_phones", []))
                        #stats["matched_phones"] = list(set(stats["matched_phones"]))  # 去重

                    except Exception as e:
                        print(f"扫描文件 {file_path} 时发生错误: {e}")

                    # 更新进度条
                    scanned_files += 1
                    progress_var.set((scanned_files / file_count) * 100)
                    progress_window.update_idletasks()

        # 将扫描结果写入文件
        with open(result_filename, 'w', encoding='utf-8') as out:
            out.write('#扫描开始===========================================================\n')
            for line in all_results:
                out.write(line)
            # 写入统计结果
            write_summary(out, scan_type, stats)
            out.write('#扫描完毕===========================================================\n')



    except Exception as e:
        print(f"扫描过程中发生错误: {e}")

    finally:
        # 确保进度窗口总是被销毁
        if progress_window:
            progress_window.destroy()

    # 构造统计结果的字符串
    result_message = f"扫描结果已保存到: {result_filename}\n\n"

    if scan_type == 'keyword':
        result_message += f"总计命中{stats['total_keyword_hits']}个敏感文字\n"
    elif scan_type == 'id':
        result_message += f"总计命中{stats['total_id_count']}个身份证号\n"
    elif scan_type == 'phone':
        result_message += f"总计命中{stats['total_phone_count']}个手机号\n"

    # 显示扫描结果
    messagebox.showinfo("扫描结果", result_message)


