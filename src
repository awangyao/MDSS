# 抽取 PDF 文件中的文本
def extract_pdf(file_path):
    pdf_reader = PyPDF2.PdfReader(open(file_path, 'rb'))
    text = ''
    for page in range(len(pdf_reader.pages)):
        page_text = pdf_reader.pages[page]
        text += page_text.extract_text()
    return text.replace('\n', ' ')

# 抽取 Office 文件 (docx, pptx, xlsx)
from docx import Document

def extract_docx(file_path):
    doc = Document(file_path)
    text = ''
    for para in doc.paragraphs:
        text += para.text + '\n'
    return text
import win32com.client as win32
# 提取.doc文件的内容（使用win32com）
def extract_doc(file_path):
    word = win32.Dispatch("Word.Application")
    word.Visible = False  # 不显示 Word 窗口
    doc = word.Documents.Open(file_path)
    text = doc.Content.Text
    doc.Close()
    word.Quit()
    return text
from pptx import Presentation

def extract_pptx(file_path):
    prs = Presentation(file_path)
    text = ''
    for slide in prs.slides:
        for shape in slide.shapes:
            if hasattr(shape, "text"):
                text += shape.text + '\n'
    return text



from aspose.slides import Presentation

def extract_ppt(file_path):
    """
    使用 Aspose.Slides 提取 .ppt 文件的文本内容
    """
    prs = Presentation(file_path)  # 加载 .ppt 文件
    text = ''  # 存储提取的文本

    for slide in prs.slides:  # 遍历每张幻灯片
        for shape in slide.shapes:  # 遍历每个形状
            if shape.text_frame is not None:  # 检查形状是否有文本框
                text += shape.text_frame.text + '\n'  # 提取文本并添加换行符

    return text

def extract_xlsx(file_path):
    wb = openpyxl.load_workbook(file_path, data_only=True)
    text = ''
    for sheet in wb.sheetnames:
        ws = wb[sheet]
        for row in ws.iter_rows():
            for cell in row:
                text += str(cell.value) + ' '  # 以空格分隔每个单元格的内容
        text += '\n'
    return text
# 提取.xls文件的内容（使用xlrd）
import xlrd

def extract_xls(file_path):
    wb = xlrd.open_workbook(file_path)
    text = ''
    for sheet in wb.sheets():
        for row in range(sheet.nrows):
            for col in range(sheet.ncols):
                text += str(sheet.cell_value(row, col)) + ' '  # 以空格分隔每个单元格的内容
        text += '\n'
    return text

# 抽取 TXT 文件中的文本
def extract_txt(file_path):
    with open(file_path, 'rb') as f:
        temp_text = f.read()
    encoding = chardet.detect(temp_text)['encoding']
    if encoding is None or encoding.lower() in ['gbk', 'gb2312']:
        encoding = 'gbk'
    else:
        encoding = 'utf-8'
    return temp_text.decode(encoding, 'ignore')

# 扫描文件夹并检查指定的关键字
def traversal_folder(file_path, keywords, scan_type):
    file_results = []  # 用于存储单个文件的扫描结果
    file_stats = {
        "total_keyword_hits": 0,
        "keyword_hits": {key: 0 for key in keywords},
        "total_id_count": 0,
        "matched_ids": [],  # 使用列表记录身份证号
        "total_phone_count": 0,
        "matched_phones": [],  # 使用列表记录手机号
    }

    try:
        # 根据文件类型提取内容
        if file_path.endswith('.pdf'):
            text = try_read_file(file_path, extract_pdf)
        elif file_path.endswith('.docx'):
            text = try_read_file(file_path, extract_docx)  # 使用新的 extract_docx
        elif file_path.endswith('.pptx'):
            text = try_read_file(file_path, extract_pptx)  # 使用新的 extract_pptx
        elif file_path.endswith('.xlsx'):
            text = try_read_file(file_path, extract_xlsx)  # 使用新的 extract_xlsx
        elif file_path.endswith('.txt'):
            text = try_read_file(file_path, extract_txt)
        elif file_path.endswith('.doc'):
            text = try_read_file(file_path, extract_doc)  # 使用新的 extract_doc
        elif file_path.endswith('.ppt'):
            text = try_read_file(file_path, extract_ppt)  # 使用新的 extract_ppt
        elif file_path.endswith('.xls'):
            text = try_read_file(file_path, extract_xls)  # 使用新的 extract_xls

        else:
            return file_results, file_stats  # 不支持的文件类型

        # 扫描内容
        if text:
            if scan_type == 'keyword':
                hit_keywords, total_hits = contains(text, keywords)
                file_stats["total_keyword_hits"] += total_hits
                for key, count in hit_keywords.items():
                    file_stats["keyword_hits"][key] += count
                if hit_keywords:
                    hits_summary = "：".join([f"{k}命中{v}次" for k, v in hit_keywords.items()])
                    file_results.append(f'×扫描{os.path.normpath(file_path)}{hits_summary}\n')
                else:
                    file_results.append(f'√通过扫描{os.path.normpath(file_path)}\n')

            elif scan_type == 'id':
                ids = idset(text)
                id_count = len(ids)
                file_stats["total_id_count"] += id_count
                file_stats["matched_ids"].extend(ids)  # 将命中的身份证号追加到列表中
                if id_count > 0:
                    file_results.append(f'×扫描{os.path.normpath(file_path)}：命中{id_count}个身份证号 {"：".join(ids)}\n')
                else:
                    file_results.append(f'√通过扫描{os.path.normpath(file_path)}\n')

            elif scan_type == 'phone':
                phones = phoneset(text)
                phone_count = len(phones)
                file_stats["total_phone_count"] += phone_count
                file_stats["matched_phones"].extend(phones)  # 将命中的手机号追加到列表中
                if phone_count > 0:
                    file_results.append(f'×扫描{os.path.normpath(file_path)}：命中{phone_count}个手机号{"：".join(phones)}\n')
                else:
                    file_results.append(f'√通过扫描{os.path.normpath(file_path)}\n')

    except Exception as e:
        print(f"处理文件 {os.path.normpath(file_path)} 时出错: {e}")

    return file_results, file_stats
