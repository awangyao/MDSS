def write_summary(out, scan_type, stats):
    out.write('#结果摘要-----------------------------------------------------------\n')

    if scan_type == 'keyword':
        out.write(f'总计命中{stats["total_keyword_hits"]}个敏感文字\n')
        if stats["total_keyword_hits"] > 0:
            # 格式化输出为 <敏感文字, 次数>
            keyword_list = [f'<{key}，{count}>' for key, count in stats["keyword_hits"].items() if count > 0]
            out.write(f'命中敏感文字列表：{"：".join(keyword_list)}\n')
        else:
            out.write('未发现任何命中的敏感文字。\n')

    elif scan_type == 'id':
        out.write(f'总计命中{stats["total_id_count"]}个身份证号\n')
        if stats["matched_ids"]:
            # 统计身份证号及出现次数（从列表转换为字典）
            id_counts = {}
            for id_ in stats["matched_ids"]:
                id_counts[id_] = id_counts.get(id_, 0) + 1

            # 格式化输出为 <值, 次数>
            id_list = [f'<{id_}，{count}>' for id_, count in id_counts.items()]
            out.write(f'命中身份证号列表：{"：".join(id_list)}\n')
        else:
            out.write('未发现任何命中的身份证号。\n')

    elif scan_type == 'phone':
        out.write(f'总计命中{stats["total_phone_count"]}个手机号\n')
        if stats["matched_phones"]:
            # 统计手机号及出现次数（从列表转换为字典）
            phone_counts = {}
            for phone in stats["matched_phones"]:
                phone_counts[phone] = phone_counts.get(phone, 0) + 1

            # 格式化输出为 <值, 次数>
            phone_list = [f'<{phone}，{count}>' for phone, count in phone_counts.items()]
            out.write(f'命中手机号列表：{"：".join(phone_list)}\n')
        else:
            out.write('未发现任何命中的手机号。\n')


# 用于获取资源文件的绝对路径
def resource_path(relative_path):
    """ 获取打包后资源文件的路径，并规范化为反斜杠格式 """
    if hasattr(sys, '_MEIPASS'):
        # PyInstaller 打包后会将资源文件放在 _MEIPASS 目录下
        path = os.path.join(sys._MEIPASS, relative_path)
    else:
        path = os.path.join(os.path.abspath(""), relative_path)

    # 使用 os.path.normpath 统一路径为当前系统的格式（在 Windows 上为反斜杠）
    return os.path.normpath(path)

