# 创建渐变按钮函数
def create_gradient_button(parent, text, command, width=150, height=50, border_color="#4F94CD", border_width=2):
    # 创建 Canvas 作为按钮容器
    canvas = tk.Canvas(
        parent,
        width=width + 2 * border_width,
        height=height + 2 * border_width,
        bd=0,
        highlightthickness=0,
        relief="flat"
    )
    canvas.grid_propagate(False)

    # 自定义渐变颜色（顶部浅蓝 -> 中间深蓝 -> 底部浅蓝）
    top_color = (210, 235, 255)   # 顶部颜色 (浅蓝色 RGB)
    middle_color = (72, 135, 188)  # 中间颜色 (深蓝 RGB)

    diffusion_ratio = 1
    diffusion_height = int(height * diffusion_ratio / 2)

    # 绘制渐变背景
    for i in range(height):
        if i < diffusion_height:
            r = int(top_color[0] + (middle_color[0] - top_color[0]) * (i / diffusion_height))
            g = int(top_color[1] + (middle_color[1] - top_color[1]) * (i / diffusion_height))
            b = int(top_color[2] + (middle_color[2] - top_color[2]) * (i / diffusion_height))
        elif i > height - diffusion_height:
            r = int(middle_color[0] + (top_color[0] - middle_color[0]) * ((i - (height - diffusion_height)) / diffusion_height))
            g = int(middle_color[1] + (top_color[1] - middle_color[1]) * ((i - (height - diffusion_height)) / diffusion_height))
            b = int(middle_color[2] + (top_color[2] - middle_color[2]) * ((i - (height - diffusion_height)) / diffusion_height))
        else:
            r, g, b = middle_color

        color = f"#{r:02x}{g:02x}{b:02x}"
        canvas.create_line(
            border_width, i + border_width,
            width + border_width, i + border_width,
            fill=color
        )

    # 绘制按钮边框
    canvas.create_rectangle(
        0, 0, width + 2 * border_width, height + 2 * border_width,
        outline=border_color,
        width=border_width
    )

    # 绘制按钮文字
    canvas.create_text(
        (width + 2 * border_width) / 2, (height + 2 * border_width) / 2,  # 文字居中
        text=text,
        fill="white",
        font=("SimHei", 12, "bold")
    )

    # 绑定点击事件
    def on_click(event):
        command()

    canvas.bind("<Button-1>", on_click)

    return canvas

