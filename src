def get_usb_devices():
    """
    获取当前连接的所有 U 盘信息。
    """
    c = wmi.WMI()
    usb_devices = []
    for disk in c.Win32_DiskDrive():
        if "Removable" in disk.MediaType:  # 只检查可移动存储设备
            usb_devices.append({
                "DeviceID": disk.DeviceID,
                "PNPDeviceID": disk.PNPDeviceID,
                "Model": disk.Model
            })
    return usb_devices

