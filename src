# 创建渐变分割线函数
def create_gradient_separator(parent, width, height, start_color, end_color):
    """
    创建一个渐变分割线
    :param parent: 父窗口
    :param width: 分割线宽度
    :param height: 分割线高度
    :param start_color: 渐变起始颜色 (RGB 元组)
    :param end_color: 渐变结束颜色 (RGB 元组)
    :return: Canvas 对象
    """
    canvas = tk.Canvas(parent, width=width, height=height, bd=0, highlightthickness=0, relief="flat")

    # 计算颜色渐变
    for i in range(height):
        r = int(start_color[0] + (end_color[0] - start_color[0]) * (i / height))
        g = int(start_color[1] + (end_color[1] - start_color[1]) * (i / height))
        b = int(start_color[2] + (end_color[2] - start_color[2]) * (i / height))
        color = f"#{r:02x}{g:02x}{b:02x}"  # 转换为 Hex 格式
        canvas.create_line(0, i, width, i, fill=color)

    return canvas

