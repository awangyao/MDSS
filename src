# 使用 Windows API 将窗口与任务栏绑定
def force_taskbar_icon():
    try:
        root.update_idletasks()  # 确保 Tkinter 窗口完成初始化
        hwnd = ctypes.windll.user32.FindWindowW(None, "MCSS")  # 通过窗口标题获取窗口句柄
        if not hwnd:
            hwnd = ctypes.windll.user32.GetForegroundWindow()  # 如果找不到句柄，尝试获取前台窗口

        # 强制激活窗口
        ctypes.windll.user32.ShowWindow(hwnd, 5)  # 显示窗口（SW_SHOW）
        ctypes.windll.user32.SetForegroundWindow(hwnd)  # 激活窗口

        # 绑定任务栏
        ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID("myappid")  # 设置应用 ID
        ctypes.windll.user32.SetWindowLongPtrW(hwnd, -20, ctypes.windll.user32.GetWindowLongPtrW(hwnd,-20) & ~0x00000080)  # 强制设置窗口样式
    except Exception as e:
        print(f"任务栏图标绑定失败: {e}")

    # 在窗口完全初始化后调用强制绑定


root.after(100, force_taskbar_icon)
