def make_window_rounded(hwnd, width, height, radius):
    #print(f"设置圆角: 窗口句柄={hwnd}, 宽度={width}, 高度={height}, 圆角半径={radius}")
    region = ctypes.windll.gdi32.CreateRoundRectRgn(0, 0, width, height, radius, radius)
    result = ctypes.windll.user32.SetWindowRgn(hwnd, region, True)
    ctypes.windll.user32.SetWindowPos(hwnd, 0, 0, 0, 0, 0, 0x0001 | 0x0002 | 0x0040)  # 强制更新窗口
    #print(f"圆角设置结果: {result}")

