def is_valid_usb_connected(target_id):
    """
    检查目标 U 盘是否插入，匹配 PNPDeviceID。
    """
    c = wmi.WMI()
    for disk in c.Win32_DiskDrive():
        if "Removable" in disk.MediaType:
            if target_id in disk.PNPDeviceID:
                return True
    return False

